# Скопируйте в `.env` на сервере развёртывания. Реальные секреты в репозиторий не коммитить.
# Пример ниже — прод: свой домен, DNS (A/AAAA) на внешний IP, порты 80/443.

# --- Let’s Encrypt / Nginx ---
# LE_DOMAIN: для кириллического домена удобнее Punycode (ACE), так надёжнее для certbot и server_name.
# LE_EMAIL: почта для уведомлений Let’s Encrypt.
# NGINX_MODE: http-only (до выпуска сертификата) | http-and-https (после certbot).
LE_DOMAIN=app.example.com
LE_EMAIL=you@example.com
NGINX_MODE=http-only

# --- Django ---
# Прод: DEBUG выключен.
DJANGO_DEBUG=0
# Сгенерируйте длинную случайную строку (не используйте значение из примера в проде).
DJANGO_SECRET_KEY=replace-with-a-long-random-string
# И apex, и www; для кириллического домена — и в Unicode, и в ACE (Punycode), на случай разного Host в браузере.
DJANGO_ALLOWED_HOSTS=app.example.com,www.app.example.com
# Только https://… для каждого хоста, с которого идёт POST (форма входа, CSRF).
DJANGO_CSRF_TRUSTED_ORIGINS=https://app.example.com,https://www.app.example.com
# 1 — если TLS терминирует nginx и в Django приходит X-Forwarded-Proto.
DJANGO_BEHIND_HTTPS_PROXY=1

# Путь к SQLite внутри контейнера `web` (том в docker-compose).
DJANGO_SQLITE_PATH=/app/db/db.sqlite3

# --- Ollama / LLM ---
# В Docker к Ollama ходит контейнер `web` по имени сервиса compose; не подставляйте 127.0.0.1 с хоста.
REFLECTION_OLLAMA_BASE_URL=http://ollama:11434
# Второй базовый URL вручную (опционально). Иначе при host=ollama может автоматически добавиться host.docker.internal.
# REFLECTION_OLLAMA_FALLBACK_BASE_URL=http://host.docker.internal:11434
# REFLECTION_OLLAMA_AUTO_HOST_FALLBACK=1
# Тег модели в Ollama (ollama list); подставьте свою.
REFLECTION_LLM_MODEL=qwen2.5:7b-instruct
# Таймаут HTTP к Ollama при генерации (секунды).
REFLECTION_LLM_TIMEOUT_S=180
