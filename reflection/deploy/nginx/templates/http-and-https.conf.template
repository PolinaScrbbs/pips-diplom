resolver 127.0.0.11 valid=10s ipv6=off;
resolver_timeout 5s;

server {
    listen 80;
    listen [::]:80;
    server_name __LE_DOMAIN__;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # ACME only on :80; everything else (including /static/) redirects to HTTPS.
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name __LE_DOMAIN__;

    ssl_certificate /etc/letsencrypt/live/__LE_DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__LE_DOMAIN__/privkey.pem;

    location /static/ {
        alias /var/www/django/static/;
        access_log off;
        expires 30d;
    }

    location /media/ {
        alias /var/www/django/media/;
        expires 7d;
    }

    location / {
        set $django_upstream http://web:8000;
        proxy_pass $django_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Connection "";
        proxy_connect_timeout 75s;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
