# Docker embedded DNS — defer resolving `web` until request time (avoids nginx -t / startup races).
resolver 127.0.0.11 valid=10s ipv6=off;
resolver_timeout 5s;

server {
    listen 80;
    listen [::]:80;
    server_name __LE_DOMAIN__;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Django DEBUG=0 does not serve static; collectstatic → volume; nginx serves MIME correctly.
    location /static/ {
        alias /var/www/django/static/;
        access_log off;
        expires 30d;
    }

    location /media/ {
        alias /var/www/django/media/;
        expires 7d;
    }

    location / {
        set $django_upstream http://web:8000;
        proxy_pass $django_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_connect_timeout 75s;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
